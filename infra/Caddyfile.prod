# Production reverse proxy — three public surfaces on one VPS:
#   pro.nnact.com       → NNACT Pro web app
#   api.pro.nnact.com   → NNACT Pro API
#   nnact.com (+ www)   → public marketing site (static Vite build)

(security_headers) {
	encode zstd gzip
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}

{$NNPAPI_ADDRESS} {
	import security_headers
	reverse_proxy api:3001
	log {
		output stdout
		format json
	}
}

{$NNPSITE_ADDRESS} {
	import security_headers

	handle /welcome* {
		root * /srv/landing
		try_files {path} /index.html
		file_server
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format json
	}
}

{$NNPMARKETING_WWW} {
	import security_headers
	redir https://{$NNPMARKETING_ADDRESS}{uri} permanent
}

{$NNPMARKETING_ADDRESS} {
	import security_headers
	root * /srv/marketing
	try_files {path} /index.html
	file_server
	log {
		output stdout
		format json
	}
}
