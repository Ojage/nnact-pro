# Production reverse proxy — four public surfaces on one VPS:
#   pro.nnact.com         → NNACT Pro web app
#   api.pro.nnact.com     → NNACT Pro API
#   nnact.com (+ www)     → public marketing site (static Vite build)
#   salathiel.ojage.org   → Ojage portfolio (static CRA build)
#
# The portfolio is a separate project sharing this host, so it gets its own
# vhost and its own document root. Nothing about NNACT Pro depends on it, and
# removing it cannot affect the three surfaces above.

(security_headers) {
	encode zstd gzip
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}

{$NNPAPI_ADDRESS} {
	import security_headers
	reverse_proxy api:3001
	log {
		output stdout
		format json
	}
}

{$NNPSITE_ADDRESS} {
	import security_headers

	handle /welcome* {
		root * /srv/landing
		try_files {path} /index.html
		file_server
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format json
	}
}

{$NNPMARKETING_WWW} {
	import security_headers
	redir https://{$NNPMARKETING_ADDRESS}{uri} permanent
}

{$NNPMARKETING_ADDRESS} {
	import security_headers
	root * /srv/marketing
	try_files {path}/index.html {path} /index.html
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@html path *.html /en /fr /en/* /fr/*
	header @html Cache-Control "no-cache"
	file_server
	log {
		output stdout
		format json
	}
}

# Ojage portfolio. Static single-page app: every path resolves to index.html so
# react-router client routes (/project/:slug) deep-link correctly on refresh.
# Content-hashed assets are immutable; index.html must never be cached, or a
# deploy would keep serving the previous bundle to returning visitors.
{$OJAGE_PORTFOLIO_ADDRESS} {
	import security_headers
	root * /srv/ojage-portfolio
	try_files {path}/index.html {path} /index.html
	@immutable path /static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@html path *.html /
	header @html Cache-Control "no-cache"
	file_server
	log {
		output stdout
		format json
	}
}
