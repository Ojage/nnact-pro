# Copy to /srv/nnact-pro/.env on the VPS (never commit real secrets).
# DNS A records for 169.58.213.92 (or your VPS IP):
#   pro.nnact.com, api.pro.nnact.com, nnact.com, www.nnact.com

NODE_ENV=production

POSTGRES_PASSWORD=replace-with-a-unique-database-password-min-16-chars
JWT_SECRET=replace-with-a-random-string-at-least-32-characters-long
JWT_EXPIRES_IN=12h

# Domains
NNPSITE_ADDRESS=pro.nnact.com
NNPAPI_ADDRESS=api.pro.nnact.com
# Blog destination apex: Website-channel publications build "Open" / canonical
# links from https://{NNPMARKETING_ADDRESS} in production (e.g. nnact.com/blog/...).
NNPMARKETING_ADDRESS=nnact.com
NNPMARKETING_WWW=www.nnact.com
NNPMARKETING_ROOT=/srv/nnact-pro/data/marketing/dist
# Ojage portfolio — a separate project sharing this VPS. Served as a static SPA
# from its own document root; needs its own DNS A record pointing here.
OJAGE_PORTFOLIO_ADDRESS=salathiel.ojage.org
# Document root for the portfolio build. Mounted read-only into Caddy.
OJAGE_PORTFOLIO_ROOT=/srv/nnact-pro/data/ojage-portfolio

# Browser / API origins (no trailing slash)
# Staff web app origin (payment redirects). NOT the blog destination.
PUBLIC_WEB_URL=https://pro.nnact.com
PUBLIC_API_URL=https://api.pro.nnact.com
# Optional explicit blog origin; overrides NNPMARKETING_ADDRESS for site links.
PUBLIC_BLOG_URL=https://nnact.com
CORS_ORIGIN=https://pro.nnact.com

# Built into the Next.js bundle at image build time
# NEXT_PUBLIC_API_URL is set from PUBLIC_API_URL in compose.prod.yml

TRUST_PROXY=true
NNPALLOW_PUBLIC_REGISTRATION=false
NNPUPLOAD_DIR=/uploads
NNPUPLOAD_MAX_BYTES=26214400

# ── AI content automation ──
# Halts ALL AI slots (emergency stop). Remove or set to false to run normally.
AI_AUTOPUBLISH_DISABLED=false
# Set to "false" to keep the worker from running the AI autopilot at all.
AI_AUTOMATION_ENABLED=true
# Optional push endpoint (https://ntfy.sh/<topic> or self-hosted) for slot
# success/failure, provider degradation, budget alarms, and the weekly digest.
NTFY_URL=

# Optional
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NTFY_URL=

# ── Email senders ──
# SMTP_FROM sets the generic default "from". Per-category senders let OTP,
# billing, service, and newsletter mail come from dedicated addresses. When a
# category var is unset it falls back to SMTP_FROM, then to the SMTP user.
SMTP_FROM="NNACT <billing@nnact.com>"
# SMTP_FROM_SECURITY="NNACT Security <security@nnact.com>"
# SMTP_FROM_BILLING="NNACT Billing <billing@nnact.com>"
# SMTP_FROM_SERVICE="NNACT Service <service@nnact.com>"
# SMTP_FROM_NEWSLETTER="NNACT News <newsletter@nnact.com>"

# ── Growth & Outreach ──
# GROWTH_SCHEDULER_ENABLED=true
# GROWTH_INBOUND_WEBHOOK_SECRET=replace-with-random-string-for-inbound-mail-hmac
# COLD_SMTP_HOST=
# COLD_SMTP_USER=
# COLD_SMTP_PASS=
# EXPLEE_READ_API_URL=
# EXPLEE_READ_API_TOKEN=

# ── Publishing Channels ──
# AES-256-GCM key for encrypting channel credentials at rest.
# Must be >= 32 characters. Required in production; the API refuses to boot
# without it. Rotating it invalidates every stored channel connection.
#   openssl rand -base64 48
# CONTENT_PUBLISHING_KEY=

# LinkedIn (Company Page publishing)
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# Meta / Facebook Pages (Facebook + Instagram)
# App ID and secret from developers.facebook.com → your app → Settings → Basic.
# The app must be a Business app using the "Manage Everything on Your Page"
# use case, with pages_manage_posts and pages_manage_engagement approved.
# META_APP_ID=
# META_APP_SECRET=
# Graph API version. Meta expires versions ~2 years after release and silently
# falls forward to the next usable version rather than erroring, so treat this
# as a dated liability and re-check the changelog each year.
#   https://developers.facebook.com/docs/graph-api/changelog/versions
# Default v25.0 (sunset 2028-07-29). v26.0 exists but has no published sunset.
# META_GRAPH_VERSION=v25.0
