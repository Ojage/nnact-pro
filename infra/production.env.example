# Copy to /srv/nnact-pro/.env on the VPS (never commit real secrets).
# DNS A records for 169.58.213.92 (or your VPS IP):
#   pro.nnact.com, api.pro.nnact.com, nnact.com, www.nnact.com

NODE_ENV=production

POSTGRES_PASSWORD=replace-with-a-unique-database-password-min-16-chars
JWT_SECRET=replace-with-a-random-string-at-least-32-characters-long
JWT_EXPIRES_IN=12h

# Domains
NNPSITE_ADDRESS=pro.nnact.com
NNPAPI_ADDRESS=api.pro.nnact.com
NNPMARKETING_ADDRESS=nnact.com
NNPMARKETING_WWW=www.nnact.com
NNPMARKETING_ROOT=/srv/nnact-pro/data/marketing/dist

# Browser / API origins (no trailing slash)
PUBLIC_WEB_URL=https://pro.nnact.com
PUBLIC_API_URL=https://api.pro.nnact.com
CORS_ORIGIN=https://pro.nnact.com

# Built into the Next.js bundle at image build time
# NEXT_PUBLIC_API_URL is set from PUBLIC_API_URL in compose.prod.yml

TRUST_PROXY=true
NNPALLOW_PUBLIC_REGISTRATION=false
NNPUPLOAD_DIR=/uploads
NNPUPLOAD_MAX_BYTES=26214400

# Optional
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NTFY_URL=
