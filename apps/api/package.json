{
  "name": "@nnact/api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "node --import tsx --experimental-test-module-mocks --test test/*.test.ts",
    "license:keypair": "tsx scripts/make-license-key.ts --generate-keypair",
    "license:generate": "tsx scripts/make-license-key.ts",
    "license:verify": "tsx scripts/verify-license-key.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^10.2.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@nnact/db": "workspace:*",
    "@nnact/plugin-sdk": "workspace:*",
    "@nnact/shared": "workspace:*",
    "@types/sanitize-html": "^2.16.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.1.0",
    "file-type": "^22.0.1",
    "firebase-admin": "^13.0.2",
    "ioredis": "^5.4.1",
    "nodemailer": "^9.0.5",
    "puppeteer": "^24.16.0",
    "sanitize-html": "^2.17.7",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "stripe": "^17.4.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
