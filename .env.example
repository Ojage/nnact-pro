# --- OpenFieldPro environment ---
# Copy to .env for local development. Never commit .env or production secrets.

NODE_ENV=development

# Postgres (local development only; use unique production credentials)
DATABASE_URL=postgres://ofp:ofp@localhost:5432/ofp

# Redis (BullMQ job queue)
REDIS_URL=redis://localhost:6379

# MinIO (local development only; rotate for every production deployment)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=ofpminio
S3_SECRET_KEY=ofpminio-secret
S3_BUCKET=ofp-uploads

# API
API_PORT=3001
# Production startup rejects this placeholder and any value shorter than 32 characters.
JWT_SECRET=change-me-in-production
# Required in production. Comma-separate exact HTTPS origins; wildcard is rejected.
CORS_ORIGIN=http://localhost:3000

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001

# Payments (leave blank for offline/manual invoicing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional support-entitlement verification. Never provide the private signing key to runtime.
OFP_LICENSE_PUBLIC_KEY_PATH=
OFP_LICENSE_KEY=
