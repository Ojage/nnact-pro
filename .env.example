# --- NNACT Pro environment ---
# Copy to .env for local development. Never commit .env or production secrets.

NODE_ENV=development

# Local application connections
DATABASE_URL=postgres://ofp:ofp@localhost:5432/ofp
REDIS_URL=redis://localhost:6379

# Production compose database credential. Replace before deployment.
POSTGRES_PASSWORD=replace-with-a-unique-database-password

# API
API_PORT=3001
# Production startup rejects this placeholder and any value shorter than 32 characters.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h
# Required in production. Comma-separate exact HTTPS origins; wildcard is rejected.
CORS_ORIGIN=http://localhost:3000,http://localhost:3002
# Enable only when the API is behind a trusted reverse proxy that replaces forwarding headers.
TRUST_PROXY=false
# Public organization creation is disabled by default in production. Enable only during controlled onboarding.
NNPALLOW_PUBLIC_REGISTRATION=false
NNPUPLOAD_DIR=./.ofp-uploads
NNPUPLOAD_MAX_BYTES=26214400
# PDF generation (API). Docker sets PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium automatically.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
# Bound each readiness dependency probe (100-10000 ms).
NNPHEALTH_PROBE_TIMEOUT_MS=2000

# Browser-facing origins
NEXT_PUBLIC_API_URL=http://localhost:3001
# PUBLIC_API_URL is an origin only; the web client appends /api to requests.
PUBLIC_API_URL=http://localhost:3001
# Exact browser-facing origin used for payment redirects.
PUBLIC_WEB_URL=http://localhost:3000
# Customer app origin for portal links, booking, and checkout redirects.
PUBLIC_CUSTOMER_URL=http://localhost:3002
NEXT_PUBLIC_CUSTOMER_APP_URL=http://localhost:3002
# Customer mobile app (Expo) — loaded via apps/*/app.config.js from root .env.
# Omit EXPO_PUBLIC_API_URL to use the hosted API (https://api.pro.nnact.com).
# For local API development only:
# EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_DEFAULT_ORG_ID=b0000001-0001-4000-8000-000000000001
# Default org UUID for public booking (/api/public/default) and customer signup.
# NNACT demo seed uses this stable organization id (DEVELOPMENT / DEMONSTRATION DATA).
DEFAULT_ORG_ID=b0000001-0001-4000-8000-000000000001
NEXT_PUBLIC_DEFAULT_ORG_ID=b0000001-0001-4000-8000-000000000001
# Production domains (Caddy on the VPS). See infra/production.env.example for a full template.
NNPSITE_ADDRESS=localhost
NNPAPI_ADDRESS=api.localhost
NNPMARKETING_ADDRESS=nnact.localhost
NNPMARKETING_WWW=www.nnact.localhost
NNPMARKETING_ROOT=/srv/nnact-webapp/dist

# Optional single static dashboard sponsor. Disabled unless explicitly true.
# Sponsor URL must be a clean HTTPS origin with no path, query string, credentials, or fragment.
NNPSPONSOR_ENABLED=false
NNPSPONSOR_NAME=
NNPSPONSOR_MESSAGE=
NNPSPONSOR_URL=

# Schema changes are fail-closed in production. deploy.sh sets this only after --apply-schema.
ALLOW_SCHEMA_PUSH=false

# Payments (leave both blank for offline/manual invoicing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Outbound customer email (SMTP). Required to email portal links and documents
# to customers. Fails closed when unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional notifications
NTFY_URL=

# --- Firebase Cloud Messaging (push + live field updates) ---
# API: Firebase Admin service account JSON (raw JSON or base64-encoded JSON).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Web + public Firebase client config (from Firebase console → Project settings).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Web push VAPID key (Firebase console → Cloud Messaging → Web configuration).
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Expo / React Native (technician + customer apps)
# Android: path to google-services.json relative to each app folder (e.g. ./google-services.json).
GOOGLE_SERVICES_JSON=./google-services.json
# iOS: path to GoogleService-Info.plist relative to each app folder.
GOOGLE_SERVICE_INFO_PLIST=./GoogleService-Info.plist
# Optional EAS project id for Expo push token routing.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Encrypted backup and restore
# scripts/backup.sh and scripts/backup.ps1 call only the fixed loopback operations controller.
# Put its bearer secret in .secrets/openfieldpro_operations_controller; never put it in this file.
# The controller reads its age recipient and PostgreSQL passfile from separately mounted files.
# Path to the offline/private age identity used only during a controlled restore.
BACKUP_AGE_IDENTITY_FILE=
NNPBACKUP_DIR=./backups

# Optional support-entitlement verification. Verification is local; never provide the private signing key to runtime.
NNPLICENSE_PUBLIC_KEY_PATH=
NNPLICENSE_KEY=

# Optional S3-compatible off-site backup replication. Production uploads remain on NNPUPLOAD_DIR.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=ofpminio
S3_SECRET_KEY=ofpminio-secret
S3_BUCKET=ofp-uploads
